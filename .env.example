# NVIDIA NIM (https://build.nvidia.com). Pick/switch models in the dashboard.
# Without a key the widget still creates tickets and a human can reply.
NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Walrus Memory (https://memory.walrus.xyz): create an account, generate a delegate key.
# Leave empty to run with a local in-process mock memory.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
# MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Network used to verify wallet sign-ins (and shown in the wallet button)
SUI_NETWORK=testnet
VITE_SUI_NETWORK=testnet
# Optional: Walruscan network for memory blob links (mainnet|testnet)
# VITE_WALRUS_NETWORK=mainnet
